@model WebQLTB.Models.BienTheBanh

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>WebQLTB.Models.BienTheBanh</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Bánh
        </dt>
        <dd class="col-sm-10">
            @(ViewBag.TenSP[Model.MaSP])
        </dd>

        <dt class="col-sm-2">
            Tên biến thể
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TenBienThe)
        </dd>

        <dt class="col-sm-2">
            Giá bán
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.GiaBan)
        </dd>

        <dt class="col-sm-2">
            Số lượng thực tế
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SoLuongThucTe)
        </dd>

        <dt class="col-sm-2">
            Số lượng đã giữ
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SoLuongDaGiu)
        </dd>

        <dt class="col-sm-2">
            Số ngày chuẩn bị dự kiến
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SoNgayChuanBiDuKien)
        </dd>

        <dt class="col-sm-2">
            Trạng thái bán
        </dt>
        <dd class="col-sm-10">
            @(Model.TrangThaiBan ? "Đang bán" : "Ngừng bán")
        </dd>
    </dl>
    @if (ViewBag.LoiXoa != null)
    {
        <div class="alert alert-danger">
            @ViewBag.LoiXoa
        </div>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaBienThe" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
