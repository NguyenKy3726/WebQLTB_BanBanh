@model WebQLTB.Models.BienTheBanh

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>BienTheBanh</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Bánh
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenSP[Model.MaSP])
        </dd>

        <dt class = "col-sm-2">
            Tên biến thể
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenBienThe)
        </dd>
 
        <dt class = "col-sm-2">
            Giá bán
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GiaBan)
        </dd>
 
        <dt class = "col-sm-2">
            Số lượng thực tế
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SoLuongThucTe)
        </dd>
 
        <dt class = "col-sm-2">
            Số lượng đã giữ
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SoLuongDaGiu)
        </dd>
   
        <dt class = "col-sm-2">
            Số ngày chuẩn bị dự kiến
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SoNgayChuanBiDuKien)
        </dd>
    
        <dt class = "col-sm-2">
            Trạng thái bán
        </dt>
        <dd class = "col-sm-10">
            @(Model.TrangThaiBan ? "Đang bán" : "Ngừng bán")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaBienThe">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
