@model WebQLTB.Models.DonHang

@{
    ViewData["Title"] = "Details";
    var lichSu = ViewBag.LichSu as IEnumerable<WebQLTB.Models.LichSuTrangThaiDonHang>
        ?? Enumerable.Empty<WebQLTB.Models.LichSuTrangThaiDonHang>();
    var trangThai = Model.TrangThaiDonHang;
    var daKetThuc = trangThai == "HOAN_TAT" || trangThai == "DA_HUY";
    var ngayGiaoMacDinh = DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:mm");
}

<h1>Details</h1>

<div>
    <h4>DonHang</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Khách hàng
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaKH.HasValue
                ? ViewBag.TenKH[Model.MaKH.Value]
                : "Khách lẻ")
        </dd>
   
        <dt class = "col-sm-2">
            Nhân viên xử lý
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaNVXuLy.HasValue
                ? ViewBag.TenNV[Model.MaNVXuLy.Value]
                : "Chưa phân công")
        </dd>
 
        <dt class = "col-sm-2">
            Nhân viên xác nhận
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaNVXacNhan.HasValue
                ? ViewBag.TenNV[Model.MaNVXacNhan.Value]
                : "Chưa xác nhận")
        </dd>
  
        <dt class = "col-sm-2">
            Nhân viên hoàn tất
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaNVHoanTat.HasValue
                ? ViewBag.TenNV[Model.MaNVHoanTat.Value]
                : "Chưa hoàn tất")
        </dd>
  
        <dt class = "col-sm-2">
            Thời điểm đặt
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayDat)
        </dd>
    
        <dt class = "col-sm-2">
            Thời điểm xác nhận
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayXacNhan)
        </dd>
  
        <dt class = "col-sm-2">
            Thời điểm hoàn tất
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayHoanTat)
        </dd>
   
        <dt class = "col-sm-2">
            Thời điểm giao hàng dự kiến
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayGiaoDuKien)
        </dd>

        <dt class = "col-sm-2">
            Trạng thái đơn hàng
        </dt>
        <dd class = "col-sm-10">
            @ViewBag.TenTrangThaiDonHang[Model.TrangThaiDonHang]
        </dd>

        <dt class = "col-sm-2">
            Người nhận
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenNguoiNhan)
        </dd>
  
        <dt class = "col-sm-2">
            Điện thoại người nhận
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DienThoaiNguoiNhan)
        </dd>
    
        <dt class = "col-sm-2">
            Địa chỉ giao hàng
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DiaChiGiaoHang)
        </dd>
    
        <dt class = "col-sm-2">
            Phí giao hàng
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhiGiaoHang)
        </dd>
   
        <dt class = "col-sm-2">
            Giảm giá
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TienGiamGia)
        </dd>
  
        <dt class = "col-sm-2">
            Tiền cọc
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TienCocYeuCau)
        </dd>
  
        <dt class = "col-sm-2">
            Tổng tiền
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TongTienHang)
        </dd>
   
        <dt class = "col-sm-2">
            Tổng tiền thanh toán
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TongTienPhaiTra)
        </dd>
    
        <dt class = "col-sm-2">
            Ghi chú
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GhiChu)
        </dd>
    </dl>
</div>
<div>
    @if (TempData["ThongBaoXuLyDon"] is string thongBao)
    {
        <div class="alert alert-success">@thongBao</div>
    }
    @if (TempData["LoiXuLyDon"] is string loi)
    {
        <div class="alert alert-danger">@loi</div>
    }

    <h3>Lịch sử xử lý</h3>
    @if (lichSu.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Thời điểm</th>
                    <th>Trạng thái trước</th>
                    <th>Trạng thái sau</th>
                    <th>Người thực hiện</th>
                    <th>Lý do / ghi chú</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in lichSu)
            {
                <tr>
                    <td>@item.ThoiDiem.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@(item.TrangThaiCu == null ? "—" : ViewBag.TenTrangThaiDonHang[item.TrangThaiCu])</td>
                    <td>@ViewBag.TenTrangThaiDonHang[item.TrangThaiMoi]</td>
                    <td>
                        @(item.MaNVThucHien.HasValue
                            ? ViewBag.TenNV[item.MaNVThucHien.Value]
                            : item.NguoiThucHien)
                    </td>
                    <td>@item.LyDo</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p>Chưa có lịch sử xử lý.</p>
    }

    <h3>Thao tác đơn hàng</h3>
    @if (daKetThuc)
    {
        <div class="alert alert-secondary">
            Đơn đã @((trangThai == "HOAN_TAT") ? "hoàn tất" : "hủy"); không thể chuyển trạng thái hoặc chỉnh sửa tiếp.
        </div>
    }
    else
    {
        @if (trangThai == "CHO_NHAN_VIEN_XU_LY")
        {
            <form asp-action="ChuyenTrangThai" method="post" class="card card-body mb-3">
                <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
                <input type="hidden" name="HanhDong" value="TIEP_NHAN" />
                <h5>Tiếp nhận và gửi khách thông tin xác nhận</h5>
                <div class="mb-2">
                    <label class="form-label">Ngày giao dự kiến</label>
                    <input type="datetime-local" name="NgayGiaoDuKien"
                           value="@ngayGiaoMacDinh" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Phí giao hàng</label>
                    <input type="number" name="PhiGiaoHang" value="@Model.PhiGiaoHang" min="0" step="0.01" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Tiền giảm giá</label>
                    <input type="number" name="TienGiamGia" value="@Model.TienGiamGia" min="0" step="0.01" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Tiền cọc yêu cầu (nhập 0 nếu không cần cọc)</label>
                    <input type="number" name="TienCocYeuCau" value="0" min="0" step="0.01" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">Tiếp nhận đơn</button>
            </form>
        }
        @if (trangThai == "CHO_KHACH_XAC_NHAN")
        {
            <form asp-action="ChuyenTrangThai" method="post" class="mb-3">
                <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
                <input type="hidden" name="HanhDong" value="KHACH_DONG_Y" />
                <button type="submit" class="btn btn-primary">Ghi nhận khách đã đồng ý</button>
            </form>
        }
        @if (trangThai == "CHO_THANH_TOAN_COC")
        {
            <form asp-action="ChuyenTrangThai" method="post" class="mb-3">
                <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
                <input type="hidden" name="HanhDong" value="XAC_NHAN" />
                <button type="submit" class="btn btn-primary">Xác nhận đơn sau khi đủ cọc</button>
            </form>
        }
        @if (trangThai == "DA_XAC_NHAN")
        {
            <form asp-action="ChuyenTrangThai" method="post" class="mb-3">
                <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
                <input type="hidden" name="HanhDong" value="BAT_DAU_CHUAN_BI" />
                <button type="submit" class="btn btn-primary">Bắt đầu chuẩn bị</button>
            </form>
        }
        @if (trangThai == "DANG_CHUAN_BI")
        {
            <form asp-action="ChuyenTrangThai" method="post" class="mb-3">
                <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
                <input type="hidden" name="HanhDong" value="SAN_SANG_GIAO" />
                <button type="submit" class="btn btn-primary">Đánh dấu sẵn sàng giao</button>
            </form>
        }
        @if (trangThai == "SAN_SANG_GIAO")
        {
            <form asp-action="ChuyenTrangThai" method="post" class="d-inline-block mb-3">
                <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
                <input type="hidden" name="HanhDong" value="DANG_GIAO" />
                <button type="submit" class="btn btn-primary">Bắt đầu giao</button>
            </form>
            <form asp-action="ChuyenTrangThai" method="post" class="d-inline-block mb-3">
                <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
                <input type="hidden" name="HanhDong" value="HOAN_TAT" />
                <button type="submit" class="btn btn-success">Hoàn tất (khách nhận tại cửa hàng)</button>
            </form>
        }
        @if (trangThai == "DANG_GIAO")
        {
            <form asp-action="ChuyenTrangThai" method="post" class="mb-3">
                <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
                <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
                <input type="hidden" name="HanhDong" value="HOAN_TAT" />
                <button type="submit" class="btn btn-success">Ghi nhận giao thành công</button>
            </form>
        }

        <form asp-action="ChuyenTrangThai" method="post" class="card card-body border-danger">
            <input type="hidden" name="MaDonHang" value="@Model.MaDonHang" />
            <input type="hidden" name="TrangThaiHienTai" value="@trangThai" />
            <input type="hidden" name="HanhDong" value="HUY" />
            <label class="form-label">Lý do hủy đơn</label>
            <textarea name="LyDoHuy" maxlength="500" class="form-control mb-2" required></textarea>
            <button type="submit" class="btn btn-outline-danger">Hủy đơn</button>
        </form>
    }

    <p class="mt-3"><a asp-action="Index">Quay lại danh sách đơn hàng</a></p>
</div>
