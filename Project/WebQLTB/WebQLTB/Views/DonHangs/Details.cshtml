@model WebQLTB.Models.DonHang

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>DonHang</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Khách hàng
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaKH.HasValue
                ? ViewBag.TenKH[Model.MaKH.Value]
                : "Khách lẻ")
        </dd>
   
        <dt class = "col-sm-2">
            Nhân viên xử lý
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaNVXuLy.HasValue
                ? ViewBag.TenNV[Model.MaNVXuLy.Value]
                : "Chưa phân công")
        </dd>
 
        <dt class = "col-sm-2">
            Nhân viên xác nhận
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaNVXacNhan.HasValue
                ? ViewBag.TenNV[Model.MaNVXacNhan.Value]
                : "Chưa xác nhận")
        </dd>
  
        <dt class = "col-sm-2">
            Nhân viên hoàn tất
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaNVHoanTat.HasValue
                ? ViewBag.TenNV[Model.MaNVHoanTat.Value]
                : "Chưa hoàn tất")
        </dd>
  
        <dt class = "col-sm-2">
            Thời điểm đặt
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayDat)
        </dd>
    
        <dt class = "col-sm-2">
            Thời điểm xác nhận
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayXacNhan)
        </dd>
  
        <dt class = "col-sm-2">
            Thời điểm xác nhận
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayHoanTat)
        </dd>
   
        <dt class = "col-sm-2">
            Thời điểm giao hàng dự kiến
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayGiaoDuKien)
        </dd>

        <dt class = "col-sm-2">
            Trạng thái đơn hàng
        </dt>
        <dd class = "col-sm-10">
            @ViewBag.TenTrangThaiDonHang[Model.TrangThaiDonHang]
        </dd>

        <dt class = "col-sm-2">
            Người nhận
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenNguoiNhan)
        </dd>
  
        <dt class = "col-sm-2">
            Điện thoại người nhận
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DienThoaiNguoiNhan)
        </dd>
    
        <dt class = "col-sm-2">
            Địa chỉ giao hàng
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DiaChiGiaoHang)
        </dd>
    
        <dt class = "col-sm-2">
            Phí giao hàng
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhiGiaoHang)
        </dd>
   
        <dt class = "col-sm-2">
            Giảm giá
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TienGiamGia)
        </dd>
  
        <dt class = "col-sm-2">
            Tiền cọc
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TienCocYeuCau)
        </dd>
  
        <dt class = "col-sm-2">
            Tổng tiền
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TongTienHang)
        </dd>
   
        <dt class = "col-sm-2">
            Tổng tiền thanh toán
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TongTienPhaiTra)
        </dd>
    
        <dt class = "col-sm-2">
            Ghi chú
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GhiChu)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaDonHang">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
