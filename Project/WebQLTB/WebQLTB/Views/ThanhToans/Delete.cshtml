@model WebQLTB.Models.ThanhToan

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>WebQLTB.Models.ThanhToan</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Mã đơn hàng
        </dt>
        <dd class="col-sm-10">
            @Model.MaDonHang
        </dd>

        <dt class="col-sm-2">
            Mã thanh toán gốc
        </dt>
        <dd class="col-sm-10">
            @(Model.MaThanhToanGoc ?? "Không có")
        </dd>

        <dt class="col-sm-2">
            Loại giao dịch
        </dt>
        <dd class="col-sm-10">
            @ViewBag.TenLoaiGiaoDich[Model.LoaiGiaoDich]
        </dd>

        <dt class="col-sm-2">
            Số tiền
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SoTien)
        </dd>

        <dt class="col-sm-2">
            Phương thức thanh toán
        </dt>
        <dd class="col-sm-10">
            @ViewBag.TenPhuongThuc[Model.PhuongThuc]
        </dd>

        <dt class="col-sm-2">
            Trạng thái thanh toán
        </dt>
        <dd class="col-sm-10">
            @ViewBag.TenTrangThaiThanhToan[Model.TrangThaiThanhToan]
        </dd>

        <dt class="col-sm-2">
            Thời điểm tạo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ThoiGianTao)
        </dd>

        <dt class="col-sm-2">
            Thời điểm xác nhận
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ThoiGianXacNhan)
        </dd>

        <dt class="col-sm-2">
            Nhân viên xác nhận
        </dt>
        <dd class="col-sm-10">
            @(Model.MaNVXacNhan.HasValue
                ? ViewBag.TenNV[Model.MaNVXacNhan.Value]
                : "Chưa xác nhận")
        </dd>

        <dt class="col-sm-2">
            Đường dẫn chứng từ
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DuongDanChungTu)
        </dd>

        <dt class="col-sm-2">
            Ghi chú
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.GhiChu)
        </dd>
    </dl>
    @if (ViewBag.LoiXoa != null)
    {
        <div class="alert alert-danger">
            @ViewBag.LoiXoa
        </div>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaThanhToan" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
