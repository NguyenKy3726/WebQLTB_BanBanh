@model List<WebQLTB.Models.ProductCardViewModel>

@{
    ViewData["Title"] = "Mua bánh";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/products.css"
          asp-append-version="true" />
}

<section class="catalog">
    <div class="catalog__intro">
        <p class="catalog__eyebrow">
            WHISKFUL COLLECTION
        </p>

        <h1 class="catalog__title">
            Một chiếc bánh, một niềm vui
        </h1>

        <p class="catalog__description">
            Khám phá những chiếc bánh dành cho sinh nhật,
            ngày kỷ niệm và những khoảnh khắc ngọt ngào.
        </p>
    </div>

    <div class="container catalog__content">
        <h2 class="catalog__heading">
            Khám phá các mẫu bánh
            <span class="catalog__count">
                @Model.Count mẫu bánh
            </span>
        </h2>
        <section class="catalog-tools" aria-label="Tìm và lọc bánh">

            <div class="catalog-search">
                <label class="visually-hidden" for="catalog-search-input">
                    Tìm bánh theo tên hoặc mô tả
                </label>

                <span class="catalog-search__icon" aria-hidden="true">⌕</span>

                <input id="catalog-search-input"
                       class="catalog-search__input"
                       type="search"
                       placeholder="Tìm bánh theo tên, dịp, phong cách, hương vị..." />

                <button class="button button--primary catalog-search__button"
                        type="button">
                    Tìm bánh
                </button>
            </div>

            <div class="catalog-tools__quick">
                <span class="catalog-tools__quick-label">Chọn nhanh</span>

                <div class="catalog-tools__chips">
                    <button class="catalog-chip" type="button">Bánh kem</button>
                    <button class="catalog-chip" type="button">Bánh mousse</button>
                    <button class="catalog-chip" type="button">Bánh quy</button>
                    <button class="catalog-chip" type="button">Bánh su</button>
                    <button class="catalog-chip" type="button">Bánh mì ngọt</button>
                </div>
            </div>

            <div class="catalog-tools__results">
                <div>
                    <h2 class="catalog-tools__title">Bánh được yêu thích</h2>
                    <p class="catalog-tools__count">
                        @Model.Count mẫu bánh
                    </p>
                </div>

                <div class="catalog-tools__actions">
                    <label class="catalog-sort">
                        <span>Sắp xếp:</span>

                        <select aria-label="Sắp xếp sản phẩm">
                            <option>Phổ biến nhất</option>
                            <option>Mới nhất</option>
                            <option>Tên A–Z</option>
                            <option>Giá thấp đến cao</option>
                            <option>Giá cao đến thấp</option>
                        </select>
                    </label>

                    <button class="catalog-filter-button"
                            id="open-catalog-filter"
                            type="button"
                            aria-controls="catalog-filter-panel"
                            aria-expanded="false">
                        <span aria-hidden="true">☷</span>
                        Bộ lọc
                    </button>
                </div>
            </div>
        </section>

        <div class="catalog-filter-backdrop"
             id="catalog-filter-backdrop"
             hidden>
        </div>

        <aside class="catalog-filter-panel"
               id="catalog-filter-panel"
               aria-labelledby="catalog-filter-title"
               aria-hidden="true">

            <div class="catalog-filter-panel__header">
                <div>
                    <h2 id="catalog-filter-title">☷ Bộ lọc</h2>
                    <p>@Model.Count mẫu bánh</p>
                </div>

                <button class="catalog-filter-panel__close"
                        id="close-catalog-filter"
                        type="button"
                        aria-label="Đóng bộ lọc">
                    ×
                </button>
            </div>

            <div class="catalog-filter-panel__body">
                <section class="filter-group">
                    <h3>Danh mục</h3>

                    <div class="filter-category-grid">
                        @{
                            var loaiBanhs =
                                ViewBag.Categories as Dictionary<byte, string>
                                ?? new Dictionary<byte, string>();
                        }

                        @foreach (var loai in loaiBanhs)
                        {
                            <label class="filter-option">
                                <input type="checkbox"
                                       class="filter-category"
                                       value="@loai.Value" />

                                <span>@loai.Value</span>
                            </label>
                        }
                    </div>
                </section>

                <section class="filter-group">
                    <h3>Khoảng giá</h3>

                    <div class="filter-price">
                        <label>
                            <span>Giá từ</span>
                            <input type="number"
                                   min="0"
                                   step="10000"
                                   placeholder="0" />
                        </label>

                        <label>
                            <span>Giá đến</span>
                            <input type="number"
                                   min="0"
                                   step="10000"
                                   placeholder="500000" />
                        </label>
                    </div>

                    <div class="filter-price">
                        <label>
                            <span>Giá từ</span>
                            <input id="filter-price-min"
                                   type="number"
                                   min="0"
                                   step="10000"
                                   placeholder="0" />
                        </label>

                        <label>
                            <span>Giá đến</span>
                            <input id="filter-price-max"
                                   type="number"
                                   min="0"
                                   step="10000"
                                   placeholder="500000" />
                        </label>
                    </div>
                </section>
            </div>

            <div class="catalog-filter-panel__footer">
                <button class="filter-clear"
                        id="clear-catalog-filter"
                        type="button">
                    Xóa tất cả
                </button>

                <button class="button button--dark"
                        id="apply-catalog-filter"
                        type="button">
                    Áp dụng
                </button>
            </div>
        </aside>
        @if (Model.Count == 0)
        {
            <p id="catalog-no-results"
               class="catalog__empty"
               hidden>
                Không tìm thấy bánh phù hợp với bộ lọc.
            </p>
        }
        else
        {
            <div class="product-grid">
                @foreach (var banh in Model)
                {
                    <partial name="~/Views/Shared/_ProductCard.cshtml"
                             model="banh" />
                }
            </div>
        }
    </div>
</section>