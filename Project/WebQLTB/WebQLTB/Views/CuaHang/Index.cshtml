@model List<WebQLTB.Models.ProductCardViewModel>
@{
    ViewData["Title"] = "Mua bánh";
    var categories = ViewBag.Categories as Dictionary<byte, string>
                     ?? new Dictionary<byte, string>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/products.css" asp-append-version="true" />
}
<section class="catalog" id="catalog" data-page-size="10">
    <div class="catalog__intro">
        <p class="catalog__eyebrow">WHISKFUL COLLECTION</p>
        <h1 class="catalog__title">Một chiếc bánh, một niềm vui</h1>
        <p class="catalog__description">
            Khám phá những chiếc bánh dành cho sinh nhật,
            ngày kỷ niệm và những khoảnh khắc ngọt ngào.
        </p>
    </div>
    <div class="container catalog__content">
        <section class="catalog-tools" aria-label="Tìm và lọc bánh">
            <form class="catalog-search" id="catalog-search-form" role="search">
                <label class="visually-hidden" for="catalog-search-input">Tìm theo tên, mô tả hoặc loại bánh</label>
                <span class="catalog-search__icon" aria-hidden="true">⌕</span>
                <input id="catalog-search-input" class="catalog-search__input"
                       type="search" placeholder="Tìm theo tên, mô tả hoặc loại bánh..." />
                <button class="button button--primary catalog-search__button" type="submit">Tìm bánh</button>
            </form>
            <div class="catalog-tools__quick">
                <span class="catalog-tools__quick-label">Chọn nhanh</span>
                <div class="catalog-tools__chips">
                    @foreach (var category in categories)
                    {
                        <button class="catalog-chip" type="button"
                                data-category="@category.Value" aria-pressed="false">@category.Value</button>
                    }
                </div>
            </div>
            <div class="catalog-tools__results" id="catalog-results">
                <div>
                    <h2 class="catalog-tools__title" tabindex="-1">Khám phá các mẫu bánh</h2>
                    <p class="catalog-tools__count" role="status" aria-live="polite">@Model.Count mẫu bánh</p>
                </div>
                <div class="catalog-tools__actions">
                    <button class="catalog-filter-button" id="open-catalog-filter" type="button"
                            aria-controls="catalog-filter-panel" aria-expanded="false">☷ Bộ lọc</button>
                    <label class="catalog-sort">
                        <select id="catalog-sort" aria-label="Sắp xếp sản phẩm">
                            <option value="default">Mặc định</option>
                            <option value="name-asc">Tên A–Z</option>
                            <option value="name-desc">Tên Z–A</option>
                            <option value="price-asc">Giá thấp đến cao</option>
                            <option value="price-desc">Giá cao đến thấp</option>
                        </select>
                    </label>
                </div>
            </div>
            <div class="catalog-active-filters" id="catalog-active-filters"
                 aria-label="Điều kiện đang áp dụng"></div>
        </section>
        <p id="catalog-no-results" class="catalog__empty" hidden="@(Model.Count > 0)">
            Không tìm thấy bánh phù hợp. Hãy thử đổi từ khóa hoặc xóa bớt điều kiện.
        </p>
        <div class="product-grid" id="catalog-grid">
            @foreach (var banh in Model)
            {
                <partial name="~/Views/Shared/_ProductCard.cshtml" model="banh" />
            }
        </div>
        <nav id="catalog-pagination" class="catalog-pagination" aria-label="Phân trang sản phẩm" hidden></nav>
        <noscript><p>Bật JavaScript để sử dụng tìm kiếm, bộ lọc và phân trang.</p></noscript>
    </div>
    <div class="catalog-filter-backdrop" id="catalog-filter-backdrop" hidden></div>
    <aside class="catalog-filter-panel" id="catalog-filter-panel" role="dialog"
           aria-modal="true" aria-labelledby="catalog-filter-title" aria-hidden="true" inert>
        <div class="catalog-filter-panel__header">
            <div>
                <h2 id="catalog-filter-title">☷ Bộ lọc</h2>
                <p id="catalog-filter-count">@Model.Count mẫu bánh</p>
            </div>
            <button class="catalog-filter-panel__close" id="close-catalog-filter"
                    type="button" aria-label="Đóng bộ lọc">×</button>
        </div>
        <form id="catalog-filter-form" class="catalog-filter-form">
            <div class="catalog-filter-panel__body">
                <section class="filter-group">
                    <h3>Danh mục</h3>
                    <div class="filter-category-grid">
                        @foreach (var category in categories)
                        {
                            <label class="filter-option">
                                <input type="checkbox" class="filter-category" value="@category.Value" />
                                <span>@category.Value</span>
                            </label>
                        }
                    </div>
                    <p class="filter-help">Có thể chọn nhiều loại bánh.</p>
                </section>
                <section class="filter-group">
                    <h3>Khoảng giá (đ)</h3>
                    <div class="filter-price">
                        <label><span>Giá từ</span>
                            <input id="filter-price-min" type="number" min="0" step="1" placeholder="Không giới hạn" />
                        </label>
                        <label><span>Giá đến</span>
                            <input id="filter-price-max" type="number" min="0" step="1" placeholder="Không giới hạn" />
                        </label>
                    </div>
                    <p class="filter-help">Dựa trên giá thấp nhất của biến thể đang bán.</p>
                    <p id="catalog-price-error" class="filter-error" role="alert" hidden></p>
                </section>
            </div>
            <div class="catalog-filter-panel__footer">
                <button class="filter-clear" id="clear-catalog-filter" type="button">Xóa tất cả</button>
                <button class="button button--dark" id="apply-catalog-filter" type="submit">Áp dụng</button>
            </div>
        </form>
    </aside>
</section>
@section Scripts {
    <script src="~/js/catalog.js" asp-append-version="true"></script>
}

