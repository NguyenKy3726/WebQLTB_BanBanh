@model WebQLTB.Models.ChiTietDonHang

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>ChiTietDonHang</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="STT" class="control-label">Số thứ tự</label>
                <input asp-for="STT" class="form-control" />
                <span asp-validation-for="STT" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaDonHang">Mã đơn hàng</label>

                <select asp-for="MaDonHang"
                        asp-items="ViewBag.MaDonHang"
                        class="form-control">
                    <option value="">-- Chọn đơn hàng --</option>
                </select>

                <span asp-validation-for="MaDonHang" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaBienThe">Biến thể</label>

                <select asp-for="MaBienThe"
                        asp-items="ViewBag.MaBienThe"
                        class="form-control">
                    <option value="">-- Chọn biến thể bánh --</option>
                </select>

                <span asp-validation-for="MaBienThe" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoLuong" class="control-label">Số lượng</label>
                <input asp-for="SoLuong" class="form-control" />
                <span asp-validation-for="SoLuong" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DonGiaTaiThoiDiemDat" class="control-label">Đơn giá tại thời điểm đặt</label>
                <input asp-for="DonGiaTaiThoiDiemDat" class="form-control" />
                <span asp-validation-for="DonGiaTaiThoiDiemDat" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoLuongCoSanDaGiu" class="control-label">Số lượng có sẵn đã giữ</label>
                <input asp-for="SoLuongCoSanDaGiu" class="form-control" />
                <span asp-validation-for="SoLuongCoSanDaGiu" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoLuongCanLam" class="control-label">Số lượng cần làm</label>
                <input asp-for="SoLuongCanLam" class="form-control" />
                <span asp-validation-for="SoLuongCanLam" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoLuongDaLam" class="control-label">Số lượng đã làm</label>
                <input asp-for="SoLuongDaLam" class="form-control" />
                <span asp-validation-for="SoLuongDaLam" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NgayDuKienCoHang" class="control-label">Ngày giao hàng dự kiến</label>
                <input asp-for="NgayDuKienCoHang" class="form-control" />
                <span asp-validation-for="NgayDuKienCoHang" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GhiChu" class="control-label">Ghi chú</label>
                <input asp-for="GhiChu" class="form-control" />
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
