<!DOCTYPE html>
<html lang="vi">
<head>
    @await RenderSectionAsync("Styles", required: false)
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebQLTB</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebQLTB.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">WebQLTB</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="CuaHang" asp-action="Index">Cửa hàng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="CuaHang" asp-action="GioHang">Giỏ hàng</a></li>
                        @if (Context.Session.GetString("Role") == "KhachHang")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="CuaHang" asp-action="DonDatHang">Đơn của tôi</a></li>
                            <li class="nav-item"><span class="nav-link">Xin chào, @Context.Session.GetString("DisplayName")</span></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                        }
                        else if (Context.Session.GetString("Role") == "NhanVien")
                        {
                            @if (Context.Session.GetString("Permission:ADMIN") == "1"
                                || Context.Session.GetString("Permission:SALES") == "1")
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="QuanLy" asp-action="Index">Bảng điều hướng quản lý</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Tạo tài khoản</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WebQLTB - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
