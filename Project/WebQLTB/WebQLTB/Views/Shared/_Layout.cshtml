@{
    Layout = "_StoreLayout";
    ViewData["AdminLayout"] = true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-common.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}
<div class="admin-workspace container">
    <nav class="admin-workspace__nav" aria-label="Điều hướng quản lý"><a asp-controller="QuanLy" asp-action="Index">← Quản lý</a></nav>
    @RenderBody()
</div>
@section Scripts {
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
