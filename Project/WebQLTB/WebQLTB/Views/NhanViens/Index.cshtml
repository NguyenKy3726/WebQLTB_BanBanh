@model IEnumerable<WebQLTB.Models.NhanVien>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Họ
            </th>
            <th>
                Tên
            </th>
            <th>
                Điện thoại
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                Tên đăng nhập
            </th>
            <th>
                Mật khẩu
            </th>
            <th>
                Avatar
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.HoNV)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenNV)
            </td>
            <td>
                @Html.DisplayFor(model => item.DienThoai)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenDN)
            </td>
            <td>
                ...
            </td>
            <td>
                @Html.DisplayFor(model => item.AnhNV)
            </td>
            <td>
                <a asp-action="Edit" asp-route-manv="@item.MaNV">Edit</a> |
                <a asp-action="Details" asp-route-manv="@item.MaNV">Details</a> |
                <a asp-action="Delete" asp-route-manv="@item.MaNV">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
