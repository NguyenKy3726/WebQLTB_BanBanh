@model IEnumerable<WebQLTB.Models.NhanVien>
@{ ViewData["Title"] = "Quản lý nhân viên"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/product-management.css" asp-append-version="true" /> }
<section class="product-admin container"><header class="product-admin__heading"><div><p class="product-admin__eyebrow">ĐỘI NGŨ WHISKFUL</p><h1>Nhân viên</h1><p>Quản lý hồ sơ và tài khoản đăng nhập của nhân viên.</p></div><a class="product-admin__button product-admin__button--primary" asp-action="Create">+ Thêm nhân viên</a></header>
@if (!Model.Any()) { <div class="product-admin__empty"><h2>Chưa có nhân viên</h2><p>Thêm tài khoản nhân viên để bắt đầu phân công quyền.</p><a class="product-admin__button product-admin__button--primary" asp-action="Create">Thêm nhân viên</a></div> }
else { <div class="table-responsive product-admin-table-wrap"><table class="table product-admin-table"><thead><tr><th>Nhân viên</th><th>Điện thoại</th><th>Email</th><th>Tên đăng nhập</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.HoNV @item.TenNV</strong></td><td>@(item.DienThoai ?? "—")</td><td>@(item.Email ?? "—")</td><td>@item.TenDN</td><td><div class="product-admin-card__actions"><a asp-action="Edit" asp-route-manv="@item.MaNV">Sửa</a><a asp-action="Details" asp-route-manv="@item.MaNV">Chi tiết</a><a asp-action="Delete" asp-route-manv="@item.MaNV">Xóa</a></div></td></tr> }</tbody></table></div> }
</section>
