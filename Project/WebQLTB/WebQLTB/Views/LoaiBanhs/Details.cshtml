@model WebQLTB.Models.LoaiBanh
@{ ViewData["Title"] = "Chi tiết loại bánh"; }
<h1>Chi tiết loại bánh</h1><div class="admin-card"><h3>@Model.TenLoaiBanh</h3><p>@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có mô tả" : Model.MoTa)</p>
<div class="admin-actions"><a class="btn btn-primary" asp-action="Edit" asp-route-maloaibanh="@Model.MaLoaiBanh">Chỉnh sửa</a><a asp-action="Index">Quay lại danh sách</a></div></div>
