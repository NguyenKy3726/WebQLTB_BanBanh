@model IEnumerable<WebQLTB.Models.LoaiBanh>
@{ ViewData["Title"] = "Quản lý loại bánh"; }
<header class="admin-heading"><div><p>DANH MỤC WHISKFUL</p><h1>Loại bánh</h1><p>Sắp xếp các mẫu bánh theo từng nhóm trong cửa hàng.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm loại bánh</a></header>
<div class="admin-card">
@if (!Model.Any()) { <p class="admin-empty">Chưa có loại bánh. Hãy thêm loại bánh đầu tiên.</p> }
else {
<div class="table-responsive"><table class="table"><thead><tr><th>Loại bánh</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td><strong>@item.TenLoaiBanh</strong></td><td>@(string.IsNullOrWhiteSpace(item.MoTa) ? "Chưa có mô tả" : item.MoTa)</td><td><div class="admin-actions"><a asp-action="Details" asp-route-maloaibanh="@item.MaLoaiBanh">Chi tiết</a><a asp-action="Edit" asp-route-maloaibanh="@item.MaLoaiBanh">Sửa</a><a asp-action="Delete" asp-route-maloaibanh="@item.MaLoaiBanh">Xóa</a></div></td></tr>
}
</tbody></table></div>
}
</div>
