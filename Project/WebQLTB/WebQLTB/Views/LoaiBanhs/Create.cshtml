@model WebQLTB.Models.LoaiBanh
@{ ViewData["Title"] = "Thêm loại bánh"; }
<h1>Thêm loại bánh</h1><div class="admin-card">
<form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="form-group"><label asp-for="TenLoaiBanh">Tên loại bánh</label><input asp-for="TenLoaiBanh" class="form-control" required /><span asp-validation-for="TenLoaiBanh" class="text-danger"></span></div>
<div class="form-group"><label asp-for="MoTa">Mô tả</label><textarea asp-for="MoTa" class="form-control" rows="4"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div>
<div class="admin-actions"><button class="btn btn-primary" type="submit">Lưu loại bánh</button><a asp-action="Index">Quay lại danh sách</a></div>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
