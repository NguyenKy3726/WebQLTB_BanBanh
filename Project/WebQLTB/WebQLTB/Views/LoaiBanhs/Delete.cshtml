@model WebQLTB.Models.LoaiBanh
@{ ViewData["Title"] = "Xóa loại bánh"; }
<h1>Xóa loại bánh</h1><div class="admin-card"><h3>@Model.TenLoaiBanh</h3><p>@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có mô tả" : Model.MoTa)</p>
<p>Bạn có chắc muốn xóa loại bánh này? Loại bánh đang được sản phẩm sử dụng có thể không xóa được.</p>
@if (ViewBag.LoiXoa != null) { <div class="alert alert-danger" role="alert">@ViewBag.LoiXoa</div> }
<form asp-action="Delete" asp-route-maloaibanh="@Model.MaLoaiBanh" method="post"><input type="hidden" asp-for="MaLoaiBanh" /><div class="admin-actions"><button class="btn btn-danger" type="submit">Xác nhận xóa</button><a asp-action="Index">Hủy và quay lại</a></div></form>
</div>
