@model WebQLTB.Models.LoaiBanh

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>WebQLTB.Models.LoaiBanh</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Loại bánh
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TenLoaiBanh)
        </dd>

        <dt class="col-sm-2">
            Mô tả
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MoTa)
        </dd>
    </dl>
    @if (ViewBag.LoiXoa != null)
    {
        <div class="alert alert-danger">
            @ViewBag.LoiXoa
        </div>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaLoaiBanh" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
