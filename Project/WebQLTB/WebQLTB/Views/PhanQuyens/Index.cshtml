@model IEnumerable<WebQLTB.Models.PhanQuyen>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Quyền
            </th>
            <th>
                Nhân viên
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(ViewBag.TenQuyen[item.MaQuyen])
            </td>
            <td>
                @item.MaNV - @(ViewBag.TenNV[item.MaNV])
            </td>
            <td>
                @* <a asp-action="Edit" asp-route-maquyen="@item.MaQuyen" asp-route-manv="@item.MaNV">Edit</a> |
                <a asp-action="Details" asp-route-maquyen="@item.MaQuyen" asp-route-manv="@item.MaNV">Details</a> | *@
                <a asp-action="Delete" asp-route-maquyen="@item.MaQuyen" asp-route-manv="@item.MaNV">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
