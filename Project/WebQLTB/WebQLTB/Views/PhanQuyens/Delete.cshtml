@model WebQLTB.Models.PhanQuyen

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Phân quyền</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Quyền
        </dt>
        <dd class="col-sm-10">
            @(ViewBag.TenQuyen[Model.MaQuyen])
        </dd>

        <dt class="col-sm-2">
            Nhân viên
        </dt>
        <dd class="col-sm-10">
            @Model.MaNV - @(ViewBag.TenNV[Model.MaNV])
        </dd>
    </dl>

    @if (ViewBag.LoiXoa != null)
    {
        <div class="alert alert-danger">
            @ViewBag.LoiXoa
        </div>
    }

    <form asp-action="Delete"
          asp-route-id="@Model.MaQuyen"
          asp-route-manv="@Model.MaNV"
          method="post">
        <input type="hidden" asp-for="MaQuyen" />
        <input type="hidden" asp-for="MaNV" />

        <input type="submit" value="Thu hồi quyền" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>