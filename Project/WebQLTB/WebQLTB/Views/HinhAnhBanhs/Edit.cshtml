@model WebQLTB.ViewModels.HinhAnhBanhFormViewModel
@{
    ViewData["Title"] = "Sửa ảnh bánh";
}
<section class="product-admin container">
    <nav class="product-admin__breadcrumb"><a asp-controller="SanPhams" asp-action="Index">Sản phẩm bánh</a><span>/</span><a asp-action="Index" asp-route-masp="@Model.MaSP">Thư viện ảnh</a><span>/</span><span>Sửa ảnh</span></nav>
    <header class="product-admin__heading"><div><p class="product-admin__eyebrow">THƯ VIỆN ẢNH</p><h1>Sửa ảnh bánh</h1><p>Thay file nếu cần, cập nhật thứ tự hoặc chuyển ảnh đại diện.</p></div></header>
    <form asp-action="Edit" asp-route-maanh="@Model.MaAnh" method="post" enctype="multipart/form-data" class="product-admin-form">
        <input asp-for="MaAnh" type="hidden" /><input asp-for="MaSP" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="product-admin-form__field"><span>Mẫu bánh</span><strong>@Model.MaSP</strong></div>
        <div class="product-admin-form__field"><span>Ảnh hiện tại</span><img class="product-admin-form__preview" src="@Url.Content(Model.DuongDanAnh)" alt="Ảnh bánh hiện tại" data-current-image /></div>
        <label class="product-admin-form__field"><span>Thay ảnh từ máy (JPG, PNG, WEBP; tối đa 5 MB)</span><input asp-for="TepAnh" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-image-picker /><span asp-validation-for="TepAnh" class="text-danger"></span></label>
        <img class="product-admin-form__preview" data-image-preview alt="Xem trước ảnh mới" hidden />
        <label class="product-admin-form__field"><span>Đường dẫn ảnh (tự đổi khi chọn file mới)</span><input asp-for="DuongDanAnh" /></label>
        <label class="product-admin-form__field"><span>Thứ tự hiển thị</span><input asp-for="ThuTuHienThi" type="number" min="1" /><span asp-validation-for="ThuTuHienThi" class="text-danger"></span></label>
        <label class="product-admin-form__check"><input asp-for="LaAnhDaiDien" /> Đặt làm ảnh đại diện</label>
        <div class="product-admin-form__actions"><button class="product-admin__button product-admin__button--primary" type="submit">Lưu thay đổi</button><a class="product-admin__button" asp-action="Index" asp-route-masp="@Model.MaSP">Quay lại</a></div>
    </form>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/product-management.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/pages/product-images.js" asp-append-version="true"></script> }
