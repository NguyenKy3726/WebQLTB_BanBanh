@model WebQLTB.Models.HinhAnhBanh

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>WebQLTB.Models.HinhAnhBanh</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Bánh
        </dt>
        <dd class="col-sm-10">
            @(ViewBag.TenSP[Model.MaSP])
        </dd>

        <dt class="col-sm-2">
            Link
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DuongDanAnh)
        </dd>

        <dt class="col-sm-2">
            Ảnh đại diện
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LaAnhDaiDien)
        </dd>

        <dt class="col-sm-2">
            Thứ tự
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ThuTuHienThi)
        </dd>
    </dl>
    @if (ViewBag.LoiXoa != null)
    {
        <div class="alert alert-danger">
            @ViewBag.LoiXoa
        </div>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="MaAnh" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
