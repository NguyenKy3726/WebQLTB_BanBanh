@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="account-auth-screen" aria-label="Tài khoản Whiskful">
    <div class="account-auth-shell" data-auth-shell>
        <section class="account-auth-welcome" aria-labelledby="welcome-title">
            <img class="account-auth-logo" src="~/assets/images/logo/whiskful-logo.png" alt="Whiskful Bakery" />
            <h1 id="welcome-title">Xin chào, mừng bạn trở lại!</h1>
            <p class="account-auth-welcome__text">Bạn chưa có tài khoản?</p>
            <button class="account-auth-outline-button" type="button"
                    data-show-register aria-controls="register-panel" aria-expanded="false">
                Đăng ký
            </button>
        </section>

        <section class="account-auth-login" aria-labelledby="login-title">
            <div class="account-auth-form-wrap">
                <h2 id="login-title" class="account-auth-title" tabindex="-1">Đăng nhập</h2>

                <div asp-validation-summary="All" class="account-auth-validation" role="alert"></div>

                <form asp-action="Login" method="post" class="account-auth-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <label class="account-auth-field">
                    <span>Tên đăng nhập</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                    <input name="TenDN"
                           value="@(ViewData.ModelState["TenDN"]?.AttemptedValue)"
                           autocomplete="username" required maxlength="50" placeholder="Tên đăng nhập" />
                </label>

                <label class="account-auth-field account-auth-field--password">
                    <span>Mật khẩu</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                    <input name="MatKhau" type="password"
                           autocomplete="current-password" required maxlength="50" placeholder="Mật khẩu" />
                    <button type="button" class="account-auth-eye" data-toggle-password aria-label="Hiện mật khẩu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button>
                </label>

                    <a class="account-auth-forgot" href="#">Quên mật khẩu?</a>

                    <button class="account-auth-submit" type="submit">Đăng nhập</button>
                </form>

                <a class="account-auth-back" asp-controller="Home" asp-action="Index">Quay lại cửa hàng</a>
            </div>
        </section>

        <section id="register-panel" class="account-auth-register" aria-labelledby="register-title" aria-hidden="true">
            <img class="account-auth-register__logo" src="~/assets/images/logo/whiskful-logo.png" alt="Whiskful" />
            <h2 id="register-title" class="account-auth-title" tabindex="-1">Đăng ký tài khoản</h2>

            <div asp-validation-summary="All" class="account-auth-validation" role="alert"></div>

            <form asp-action="Register" method="post" class="account-auth-form account-auth-form--register">
                @Html.AntiForgeryToken()
                <label class="account-auth-field">
                    <span>Họ</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                    <input name="HoKH"
                           value="@(ViewData.ModelState["HoKH"]?.AttemptedValue)"
                           autocomplete="family-name" required maxlength="30" placeholder="Họ" />
                </label>
                <label class="account-auth-field">
                    <span>Điện thoại</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
                    <input name="DienThoai"
                           value="@(ViewData.ModelState["DienThoai"]?.AttemptedValue)"
                           autocomplete="tel" maxlength="11" placeholder="Điện thoại" />
                </label>
                <label class="account-auth-field">
                    <span>Tên</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                    <input name="TenKH"
                           value="@(ViewData.ModelState["TenKH"]?.AttemptedValue)"
                           autocomplete="given-name" required maxlength="20" placeholder="Tên" />
                </label>
                <label class="account-auth-field">
                    <span>Email</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>
                    <input name="Email"
                           value="@(ViewData.ModelState["Email"]?.AttemptedValue)" type="email"
                           autocomplete="email" maxlength="40" placeholder="Email" />
                </label>
                <label class="account-auth-field">
                    <span>Tên đăng nhập</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 12v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-3.5 7.1"/></svg>
                    <input name="TenDN"
                           value="@(ViewData.ModelState["TenDN"]?.AttemptedValue)"
                           autocomplete="username" required maxlength="50" placeholder="Tên đăng nhập" />
                </label>
                <label class="account-auth-field">
                    <span>Địa chỉ thường dùng</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                    <input name="DiaChiThuongDung"
                           value="@(ViewData.ModelState["DiaChiThuongDung"]?.AttemptedValue)"
                           autocomplete="street-address" maxlength="200" placeholder="Địa chỉ thường dùng" />
                </label>
                <label class="account-auth-field">
                    <span>Mật khẩu</span>
                    <svg class="account-auth-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                    <input name="MatKhau" type="password"
                           autocomplete="new-password" required maxlength="50" placeholder="Mật khẩu" />
                </label>
                <div class="account-auth-welcome-note" aria-hidden="true">
                    <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 32c1-9 8-16 17-16 4 0 7 1 9 3 4 1 8 5 9 11-3 3-8 3-11 1-4 2-9 2-12-1-3 2-8 2-12 2z"/><path d="M16 22l4 9M25 18l2 11"/><path d="M36 8c-1.5-2-4-.5-3 1.5L36 13l3-3.5c1-2-1.5-3.500-3-1.500z"/></svg>
                    <span>Chào mừng bạn<br />đến với Whiskful Bakery !</span>
                </div>
                <button class="account-auth-submit" type="submit">Tạo tài khoản</button>
            </form>

            <p class="account-auth-switch">
                Đã có tài khoản?
                <button type="button" class="account-auth-text-button" data-show-login
                        aria-controls="login-title">Đăng nhập</button>
            </p>
        </section>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/account-auth.js" asp-append-version="true"></script>
}
