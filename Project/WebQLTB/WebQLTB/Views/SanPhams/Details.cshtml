@model WebQLTB.Models.SanPham

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>SanPham</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Loại bánh
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenLoaiBanh[Model.MaLoaiBanh])
        </dd>

        <dt class = "col-sm-2">
            Tên sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenSP)
        </dd>

        <dt class = "col-sm-2">
            Mô tả
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MoTaNgan)
        </dd>

        <dt class = "col-sm-2">
            Thành phần
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MoTaChiTiet)
        </dd>

        <dt class = "col-sm-2">
            Trạng thái hiển thị
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenTrangThaiHienThi[Model.TrangThaiHienThi])
        </dd>
 
        <dt class = "col-sm-2">
            Nhân viên tạo
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenNV[Model.MaNVTao])
        </dd>

        <dt class = "col-sm-2">
            Ngày tạo
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NgayTao)
        </dd>

        <dt class = "col-sm-2">
            Nhân viên cập nhật
        </dt>
        <dd class = "col-sm-10">
            @(Model.MaNVCapNhat.HasValue
                ? ViewBag.TenNV[Model.MaNVCapNhat.Value]
                : "_")
        </dd>

        <dt class = "col-sm-2">
            Ngày cập nhật
        </dt>
        <dd class = "col-sm-10">
            @(Model.NgayCapNhat.HasValue
                ? ViewBag.TenNV[Model.NgayCapNhat]
                : "_")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaSP">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
