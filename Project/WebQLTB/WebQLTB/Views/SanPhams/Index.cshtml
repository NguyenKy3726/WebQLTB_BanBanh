@model IEnumerable<WebQLTB.Models.SanPham>
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý sản phẩm bánh";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var cakeTypes = ViewBag.TenLoaiBanh as Dictionary<byte, string> ?? new Dictionary<byte, string>();
    var images = ViewBag.AnhDaiDien as Dictionary<string, string> ?? new();
    var variants = ViewBag.SoBienThe as Dictionary<string, int> ?? new();
    var lowestPrices = ViewBag.GiaThapNhat as Dictionary<string, decimal> ?? new();
    var lowestAvailableStocks = ViewBag.TonKhaDungThapNhat as Dictionary<string, int> ?? new();
    var lowStockThreshold = (int)(ViewBag.NguongTonThap ?? 3);
    var selectedCategory = ViewBag.MaLoaiBanhDangChon as byte?;
    var selectedStatus = ViewBag.TrangThaiDangChon as string;
    var keyword = ViewBag.TuKhoa as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/product-management.css" asp-append-version="true" />
}

<section class="product-admin container" aria-labelledby="products-title">
    <nav class="product-admin__breadcrumb" aria-label="Đường dẫn">
        <a asp-controller="QuanLy" asp-action="Index">Quản lý</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Sản phẩm bánh</span>
    </nav>

    <header class="product-admin__heading">
        <div>
            <p class="product-admin__eyebrow">DANH MỤC WHISKFUL</p>
            <h1 id="products-title">Sản phẩm bánh</h1>
            <p>Tạo mẫu bánh, cập nhật trạng thái và đi thẳng tới phần quản lý phiên bản hoặc hình ảnh.</p>
        </div>
        <a class="product-admin__button product-admin__button--primary" asp-action="Create">+ Thêm mẫu bánh</a>
    </header>

    @if (ViewBag.ThongBao is string message)
    {
        <div class="product-admin__notice" role="status">@message</div>
    }

    <form method="get" class="product-admin-filter" aria-label="Lọc sản phẩm bánh">
        <label for="category-filter">Loại bánh</label>
        <select id="category-filter" name="maloai" onchange="this.form.requestSubmit()">
            <option value="">Tất cả loại bánh</option>
            @foreach (var category in cakeTypes.OrderBy(x => x.Value))
            {
                <option value="@category.Key" selected="@(selectedCategory == category.Key)">@category.Value</option>
            }
        </select>
        <label for="status-filter">Trạng thái</label>
        <select id="status-filter" name="trangthai" onchange="this.form.requestSubmit()">
            <option value="">Tất cả trạng thái</option>
            <option value="PUBLISHED" selected="@(selectedStatus == "PUBLISHED")">Đang hiển thị</option>
            <option value="DRAFT" selected="@(selectedStatus == "DRAFT")">Bản nháp</option>
            <option value="HIDDEN" selected="@(selectedStatus == "HIDDEN")">Tạm ẩn</option>
        </select>
        <label class="visually-hidden" for="product-search">Tìm sản phẩm</label>
        <input id="product-search" name="q" value="@keyword" placeholder="Tìm theo tên hoặc mã bánh" />
        <button class="product-admin__button" type="submit">Tìm</button>
        @if (selectedCategory.HasValue || !string.IsNullOrEmpty(selectedStatus) || !string.IsNullOrWhiteSpace(keyword))
        {
            <a asp-action="Index" class="product-admin__button">Xóa lọc</a>
        }
        <span class="product-admin-filter__hint">Cảnh báo tồn thấp khi còn dưới @lowStockThreshold bánh; đổi ngưỡng tại Inventory:LowStockThreshold trong appsettings.json.</span>
    </form>

    @if (!Model.Any())
    {
        <div class="product-admin__empty">
            <h2>Chưa có mẫu bánh</h2>
            <p>Tạo mẫu đầu tiên, sau đó thêm ít nhất một phiên bản và ảnh đại diện.</p>
            <a class="product-admin__button product-admin__button--primary" asp-action="Create">Tạo mẫu bánh</a>
        </div>
    }
    else
    {
        <div class="product-admin__grid">
        @foreach (var item in Model)
        {
            var hasImage = images.TryGetValue(item.MaSP, out var imagePath);
            var statusLabel = ViewBag.TenTrangThaiHienThi[item.TrangThaiHienThi] as string ?? item.TrangThaiHienThi;
            var variantCount = variants.TryGetValue(item.MaSP, out var count) ? count : 0;
            <article class="product-admin-card">
                <a class="product-admin-card__image" asp-action="Edit" asp-route-masp="@item.MaSP" aria-label="Sửa @item.TenSP">
                    @if (hasImage && !string.IsNullOrWhiteSpace(imagePath))
                    {
                        <img src="@Url.Content(imagePath)" alt="Ảnh @item.TenSP" loading="lazy" />
                    }
                    else
                    {
                        <span>Chưa có ảnh đại diện</span>
                    }
                    <span class="product-admin-card__status product-admin-card__status--@item.TrangThaiHienThi.ToLowerInvariant()">@statusLabel</span>
                </a>
                <div class="product-admin-card__body">
                    <span class="product-admin-card__category">@cakeTypes.GetValueOrDefault(item.MaLoaiBanh, "Chưa phân loại")</span>
                    <h2>@item.TenSP</h2>
                    <p>@(string.IsNullOrWhiteSpace(item.MoTaNgan) ? "Chưa có mô tả ngắn." : item.MoTaNgan)</p>
                    @if (lowestAvailableStocks.TryGetValue(item.MaSP, out var availableStock) && lowStockThreshold > 0 && availableStock < lowStockThreshold)
                    {
                        <div class="product-admin-card__stock-warning" role="status">
                            <strong>Sắp hết hàng</strong>
                            <span>Còn @availableStock bánh, dưới ngưỡng @lowStockThreshold</span>
                        </div>
                    }
                    <div class="product-admin-card__meta">
                        <span>@variantCount phiên bản</span>
                        <strong>@(lowestPrices.TryGetValue(item.MaSP, out var price) ? "Từ " + price.ToString("N0", culture) + " ₫" : "Chưa có giá")</strong>
                    </div>
                    <div class="product-admin-card__actions">
                        <a asp-controller="BienTheBanhs" asp-action="Index" asp-route-masp="@item.MaSP">Phiên bản</a>
                        <a asp-controller="HinhAnhBanhs" asp-action="Index" asp-route-masp="@item.MaSP">Hình ảnh</a>
                        <a asp-action="Edit" asp-route-masp="@item.MaSP">Sửa bánh</a>
                        <a asp-action="Details" asp-route-masp="@item.MaSP">Chi tiết</a>
                        <a asp-action="Delete" asp-route-masp="@item.MaSP">Xóa</a>
                    </div>
                </div>
            </article>
        }
        </div>
    }
</section>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const search = document.getElementById("product-search");
            if (!search) return;
            let timer;
            search.addEventListener("input", () => {
                window.clearTimeout(timer);
                timer = window.setTimeout(() => search.form?.requestSubmit(), 350);
            });
        });
    </script>
}
