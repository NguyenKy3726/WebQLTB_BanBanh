@model WebQLTB.Models.SanPham
@{ ViewData["Title"] = "Sửa mẫu bánh"; }
<section class="product-admin container">
    <nav class="product-admin__breadcrumb"><a asp-controller="QuanLy" asp-action="Index">Quản lý</a><span>/</span><a asp-action="Index">Sản phẩm bánh</a><span>/</span><span>Sửa mẫu</span></nav>
    <header class="product-admin__heading"><div><p class="product-admin__eyebrow">DANH MỤC WHISKFUL</p><h1>Sửa mẫu bánh</h1><p>Cập nhật nội dung và trạng thái hiển thị cho @Model.TenSP.</p></div></header>
    <form asp-action="Edit" asp-route-masp="@Model.MaSP" class="product-admin-form">
        <input asp-for="MaSP" type="hidden" /><input asp-for="MaLoaiBanh" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="product-admin-form__field"><span>Mã sản phẩm</span><strong>@Model.MaSP</strong></div>
        <div class="product-admin-form__field"><span>Loại bánh</span><strong>@(ViewBag.TenLoaiBanh is Dictionary<byte,string> cats && cats.TryGetValue(Model.MaLoaiBanh, out var category) ? category : $"Loại {Model.MaLoaiBanh}")</strong></div>
        <label class="product-admin-form__field"><span>Tên sản phẩm</span><input asp-for="TenSP" maxlength="100" /><span asp-validation-for="TenSP" class="text-danger"></span></label>
        <label class="product-admin-form__field"><span>Mô tả ngắn</span><textarea asp-for="MoTaNgan" rows="3" maxlength="300"></textarea><span asp-validation-for="MoTaNgan" class="text-danger"></span></label>
        <label class="product-admin-form__field"><span>Mô tả chi tiết / thành phần</span><textarea asp-for="MoTaChiTiet" rows="5"></textarea><span asp-validation-for="MoTaChiTiet" class="text-danger"></span></label>
        <label class="product-admin-form__field"><span>Trạng thái</span><select asp-for="TrangThaiHienThi" asp-items="ViewBag.TrangThaiHienThi"></select><span asp-validation-for="TrangThaiHienThi" class="text-danger"></span></label>
        <div class="product-admin-form__actions"><button class="product-admin__button product-admin__button--primary" type="submit">Lưu thay đổi</button><a class="product-admin__button" asp-action="Index">Quay lại</a></div>
    </form>
</section>
@section Styles { <link rel="stylesheet" href="~/css/pages/product-management.css" asp-append-version="true" /> }
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
